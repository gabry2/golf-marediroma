rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Amministratore = utente con email presente nella raccolta "admins" (ID documento = email in minuscolo)
    function isAdmin() {
      return signedIn() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Elenco amministratori: ognuno può solo verificare se stesso; si modifica solo dalla console
    match /admins/{email} { allow read: if signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email; allow write: if false; }

    // ---- Prenotazioni condivise (tee time e partenze delle gare) ----
    // Ogni posto è { n: giocatori totali, p: { uid: { n, at } } }: ciascuno può aggiungere,
    // cambiare o togliere SOLO la propria voce, e il totale deve tornare e restare entro il limite.
    function mine(d) { return d.p.get(request.auth.uid, {'n': 0}).n; }
    function okMine(d) {
      return !(request.auth.uid in d.p) || (
        d.p[request.auth.uid] is map && d.p[request.auth.uid].keys().hasOnly(['n', 'at'])
        && d.p[request.auth.uid].n is int && d.p[request.auth.uid].n >= 1 && d.p[request.auth.uid].n <= 4);
    }
    function okShare(od, cap) {
      let nd = request.resource.data;
      return signedIn() && od.p is map && nd.p is map && nd.n is int && nd.n >= 1 && nd.n <= cap
        && nd.p.diff(od.p).affectedKeys().hasOnly([request.auth.uid])
        && okMine(nd)
        && nd.n == od.n - mine(od) + mine(nd);
    }
    // Si può cancellare il documento solo se dentro resta soltanto la propria voce
    function onlyMine() { return signedIn() && resource.data.p is map && resource.data.p.keys().hasOnly([request.auth.uid]); }

    match /teetimes/{id} {
      allow read: if true;
      allow create: if isAdmin() || (id.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}')
        && request.resource.data.keys().hasOnly(['at', 'n', 'p']) && request.resource.data.at is int
        && okShare({'n': 0, 'p': {}}, 4));
      allow update: if isAdmin() || (request.resource.data.keys().hasOnly(['at', 'n', 'p'])
        && request.resource.data.at == resource.data.at
        && okShare(resource.data, 4));
      allow delete: if isAdmin() || onlyMine();
    }

    match /gflights/{id} {
      allow read: if true;
      allow create: if isAdmin() || (request.resource.data.keys().hasOnly(['gara', 'cap', 'n', 'p', 'pref', 'at'])
        && request.resource.data.gara is string && request.resource.data.gara.matches('[A-Za-z0-9]+')
        && id.matches(request.resource.data.gara + '_[0-9]+')
        && exists(/databases/$(database)/documents/gare/$(request.resource.data.gara))
        && request.resource.data.cap is int && request.resource.data.cap >= 1 && request.resource.data.cap <= 4
        && request.resource.data.pref is string && request.resource.data.at is int
        && okShare({'n': 0, 'p': {}}, request.resource.data.cap));
      allow update: if isAdmin() || (request.resource.data.keys().hasOnly(['gara', 'cap', 'n', 'p', 'pref', 'at'])
        && request.resource.data.gara == resource.data.gara && request.resource.data.cap == resource.data.cap
        && request.resource.data.pref == resource.data.pref && request.resource.data.at == resource.data.at
        && okShare(resource.data, resource.data.cap));
      allow delete: if isAdmin() || onlyMine();
    }

    // Cart delle gare: ognuno prende un cart libero a proprio nome e può liberare solo il proprio
    match /cart/{id} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && id.matches('[A-Za-z0-9]+_[1-9]')
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by == request.auth.uid && request.resource.data.at is int);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }

    // "Lucchetti" di pochi secondi contro le doppie prenotazioni: ognuno scrive solo i propri,
    // e può prendere quello di un altro solo se è già scaduto
    match /leases/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['h', 'exp'])
        && request.resource.data.h is string && request.resource.data.h.matches(request.auth.uid + '-[0-9]+')
        && request.resource.data.exp is int && request.resource.data.exp <= request.time.toMillis() + 600000
        && (resource == null || resource.data.exp < request.time.toMillis()
            || resource.data.h.matches(request.auth.uid + '-[0-9]+'));
      allow delete: if isAdmin();
    }

    // Gare, orari bloccati, testi dell'assistente: tutti leggono, solo gli amministratori scrivono
    match /gare/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /blockedslots/{id} { allow read: if true; allow write: if isAdmin(); }
    match /blocked/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}     { allow read: if true; allow write: if isAdmin(); }

    // Locandine e regolamenti salvati nel database: tutti li vedono, solo gli amministratori li caricano
    match /allegati/{id}     { allow read: if true; allow write: if isAdmin(); }

    // Dati personali (nomi ed email): ognuno vede e scrive solo i propri, gli amministratori leggono tutto
    match /contacts/{uid}   { allow read: if isAdmin() || isMe(uid); allow write: if isMe(uid); }
    match /iscrizioni/{uid} { allow read: if isAdmin() || isMe(uid); allow write: if isMe(uid); }

    // Flight ufficiali e anagrafica giocatori con HCP: solo gli amministratori
    match /giocatori/{id} { allow read, write: if isAdmin(); }
    match /storico/{id}   { allow read, write: if isAdmin(); }

    // Recensioni: pubblicate (le leggono tutti) e proposte dai giocatori (le vede solo il circolo)
    match /recensioni/{id} { allow read: if true; allow write: if isAdmin(); }
    match /proposte/{id} {
      allow create: if signedIn() && id.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.keys().hasOnly(['n','s','t','by','at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.n is string && request.resource.data.n.size() <= 60
        && request.resource.data.t is string && request.resource.data.t.size() <= 600
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5;
      allow read, update, delete: if isAdmin();
    }
  }
}
